# Base de datos (Postgres). En local apunta al contenedor de docker-compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/escuelitas_fut"

# Supabase: DATABASE_URL usa el pooler transaccional (6543).
# DIRECT_URL usa conexión directa o pooler de sesión (5432) para migraciones.
# Vacío en local: db:migrate utiliza DATABASE_URL.
DIRECT_URL=""

# Storage: bucket privado "images", acceso únicamente desde el servidor.
# SUPABASE_SECRET_KEY debe ser una clave sb_secret_, nunca NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Secreto para firmar las sesiones de Auth.js.
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# Login con Google (opcional). Si se dejan vacíos, solo habrá correo/contraseña.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (se usa en la fase de pagos).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Tarea diaria de mensualidades y reinscripciones en Vercel
CRON_SECRET=
